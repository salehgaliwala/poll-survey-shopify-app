<div id="shopify-survey-app"
     data-survey-id="{{ block.settings.survey_id }}"
     data-customer-id="{{ customer.id }}"
     data-customer-email="{{ customer.email }}">
</div>

<script src="{{ 'survey-widget.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Survey Widget",
  "target": "section",
  "settings": [
    { "type": "text", "id": "survey_id", "label": "Survey ID" }
  ]
}
{% endschema %}
